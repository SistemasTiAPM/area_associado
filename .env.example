# =============================================================================
# area_associado — variáveis de ambiente. Copie para .env (chmod 600).
# Toda mudança no .env deve ser replicada no AWS Secrets Manager
# (sa-east-1, segredo prod/area-associado/env) — é a única cópia fora da EC2.
# Gere segredos com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# ---- Banco (RDS MySQL) — schema e usuário EXCLUSIVOS desta app ---------------
DB_HOST=mysql-producao.cjosi8yos8m5.sa-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=area_associado
DB_USER=apm_area
DB_PASS=
# TLS verificado contra o bundle da AWS embutido na imagem. DB_SSL_VERIFY=0 é
# recusado quando APP_ENV=production (config.py).
DB_SSL_CA=/etc/ssl/rds/global-bundle.pem
DB_SSL_VERIFY=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ---- Aplicação ---------------------------------------------------------------
# production | staging | development. Em staging o cookie já é Secure e o
# OpenAPI fica desligado; só `development` relaxa isso.
APP_ENV=staging
SECRET_KEY=
# Sessão da área: deslizante (cookie) e teto absoluto desde o login (segundos).
SESSION_MAX_AGE=28800
SESSION_ABSOLUTE_MAX=43200
# Sem barra final. Deriva redirect_uri (/auth/callback) e post_logout_redirect_uri (/).
PUBLIC_BASE_URL=https://associado.apm.org.br

# ---- Autenticação ------------------------------------------------------------
# oidc = login delegado ao login_associado (alvo de produção).
# stub = modo interino para construir as telas; RECUSADO em APP_ENV=production.
AUTH_MODE=stub
# Obrigatório em stub (>= 32 chars). Apague ao virar a chave.
DEV_STUB_TOKEN=

# ---- OIDC (Relying Party do login.apm.org.br) --------------------------------
# `iss` do id_token e base do front-channel (/oauth/authorize, /oauth/logout).
OIDC_ISSUER=https://login.apm.org.br
# Back-channel (token, userinfo, jwks) pela rede Docker, sem hairpin via
# Cloudflare e fora da zona oauth_token do edge. O header Host é ajustado
# automaticamente para o host do issuer. Para usar o edge: https://login.apm.org.br
OIDC_BACKCHANNEL_BASE_URL=http://login_associado:8000
OIDC_CLIENT_ID=area-associado
# Impresso UMA vez por `scripts/generate_client.py --apply` no login_associado.
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email cpf
# Validade do pedido de autorização guardado na sessão (= OAUTH_PENDING_TTL do IdP).
OIDC_PENDING_TTL=600
# Cache do JWKS (= proxy_cache_valid do edge para /oauth/jwks.json).
OIDC_JWKS_TTL=300
OIDC_HTTP_TIMEOUT=10
OIDC_LEEWAY=60

# ---- Auditoria (evento_log) --------------------------------------------------
# Pepper dos hashes de sub/ip/ua gravados no evento_log. Vazio = SECRET_KEY.
LOG_HASH_KEY=
EVENTO_LOG_TABLE=evento_log

# --------------------------------------------------------------------- #
# Sessão cifrada (ADR-0011). Lista separada por vírgula: a PRIMEIRA       #
# cifra, todas decifram (rotação: acrescente a nova à esquerda, aguarde   #
# SESSION_MAX_AGE e remova a antiga). OBRIGATÓRIA com APP_ENV=production. #
# Gerar: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# --------------------------------------------------------------------- #
SESSION_ENC_KEYS=

# --------------------------------------------------------------------- #
# Interface (entregue à SPA em GET /api/v1/sessao)                       #
# --------------------------------------------------------------------- #
WHATSAPP_CENTRAL=551131886200
SHOW_WHATSAPP=1
ANIMATIONS=1
# Vencem a tabela feature_flag (ADR-0007). Em produção, manter as três
# abaixo até existir fonte de dados (P-12).
FLAGS_FORCAR_DESLIGADAS=mensalidade_zero,fatura_valor,patrocinio
FLAGS_CACHE_TTL=60
# Origens https permitidas em img-src (CSP), separadas por vírgula.
CSP_IMG_HOSTS=https://www.apm.org.br
